# Copy this file to .env and fill in the three office values.
# Office model server (OpenAI-compatible). Base URL = the part before /chat/completions.
VAS_API_BASE_URL=https://<office-qwen-server>/v1
VAS_API_MODEL=<model name exactly as the server expects>
VAS_API_KEY=<your api key>

# Optional — defaults shown
VAS_REQUEST_TIMEOUT=300
VAS_TEMPERATURE=0.1
VAS_MAX_NEW_TOKENS=1024
VAS_MAX_PIXELS=802816
VAS_MAX_PIXELS_MULTI=200704
VAS_MAX_PIXELS_MULTI_TOTAL=802816
VAS_MAX_MULTI_IMAGES=6
VAS_BBOX_MODE=absolute

# Where cases are stored
# VAS_DATA_DIR=./data
